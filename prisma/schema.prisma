// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  accounts              PlaidAccount[]
  reports               Report[]
  recurringReports      RecurringReport[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  syncedTransactions    SyncedTransaction[]
  notes                 Note[]
  authorized            Boolean                @default(false)
}

model PlaidAccount {
  id                 Int                 @id @default(autoincrement())
  userId             String // Foreign key to User
  user               User                @relation(fields: [userId], references: [id])
  institutionName    String
  accessToken        String
  itemId             String              @unique
  syncedTransactions SyncedTransaction[]
  cursor             PlaidCursor?
  syncLock           PlaidSyncLock?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
}

model Report {
  id                 Int           @id @default(autoincrement())
  userId             String // Foreign key to User
  user               User          @relation(fields: [userId], references: [id])
  transactions       Transaction[]
  reportName         String
  reportType         ReportType    @default(MONTHLY)
  parentReportId     Int? // For hierarchical reports
  parentReport       Report?       @relation("ParentChild", fields: [parentReportId], references: [id])
  childReports       Report[]      @relation("ParentChild")
  foodAndDrink       Float         @default(0)
  billsAndUtilities  Float         @default(0)
  car                Float         @default(0)
  entertainment      Float         @default(0)
  groceries          Float         @default(0)
  healthAndWellness  Float         @default(0)
  personal           Float         @default(0)
  shopping           Float         @default(0)
  feesAndAdjustments Float         @default(0)
  others             Float         @default(0)
  revenue            Float         @default(0)
  foster             Float         @default(0)
  expenses           Float         @default(0)
  total              Float         @default(0)
  status             ReportStatus  @default(APPROVED)
  month              Int?
  year               Int?
  autoMaintainedAt   DateTime?
  approvedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId, reportType])
  @@index([userId, status])
  @@index([parentReportId])
}

model RecurringReport {
  id                  Int                    @id @default(autoincrement())
  userId              String // Foreign key to User
  user                User                   @relation(fields: [userId], references: [id])
  inflowTransactions  RecurringTransaction[] @relation(name: "InflowReport")
  outflowTransactions RecurringTransaction[] @relation(name: "OutflowReport")
  reportName          String
  inflow              Float                  @default(0)
  outflow             Float                  @default(0)
  total               Float                  @default(0)
  createdAt           DateTime               @default(now())

  @@index([userId])
}

model RecurringTransaction {
  id              Int              @id @default(autoincrement())
  outflowReportId Int? // Foreign key to RecurringReport
  outflowReport   RecurringReport? @relation(name: "OutflowReport", fields: [outflowReportId], references: [id])
  inflowReportId  Int? // Foreign key to RecurringReport
  inflowReport    RecurringReport? @relation(name: "InflowReport", fields: [inflowReportId], references: [id])
  userId          String // Foreign key to User
  user            User             @relation(fields: [userId], references: [id])
  account_id      String
  stream_id       String
  description     String
  amount          Float
  last_date       String
  frequency       String
  createdAt       DateTime         @default(now())

  @@index([userId])
  @@index([outflowReportId])
  @@index([inflowReportId])
}

model Transaction {
  id             Int      @id @default(autoincrement())
  reportId       Int // Foreign key to Report
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId         String // Foreign key to User
  user           User     @relation(fields: [userId], references: [id])
  account_id     String
  transaction_id String
  name           String
  amount         Float
  date           String
  category       String[]
  notes          String? // Optional notes field for transactions
  createdAt      DateTime @default(now())

  @@index([userId, date])
  @@index([reportId])
}

model Note {
  id        Int      @id @default(autoincrement())
  userId    String // Foreign key to User
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Live sync data from Plaid webhooks. Scoped to a PlaidAccount — cascades on account removal.
// Reports copy from this table at creation time (Transaction model) so historical data is preserved.
model SyncedTransaction {
  id                     String       @id @default(uuid())
  userId                 String
  user                   User         @relation(fields: [userId], references: [id])
  plaidAccountId         Int
  plaidAccount           PlaidAccount @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)
  transaction_id         String
  account_id             String
  name                   String
  amount                 Float
  date                   String
  category               String[]
  original_description   String?
  merchant_name          String?
  pending                Boolean      @default(false)
  pending_transaction_id String?
  notes                  String?
  // User-intent fields. MUST be preserved across Plaid MODIFIED updates and pending→posted carryover.
  userCategoryOverride   String?
  userSoftDeleted        Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([transaction_id, plaidAccountId])
  @@index([userId, date])
  @@index([plaidAccountId])
  @@index([transaction_id])
  @@index([pending_transaction_id])
  @@index([userCategoryOverride, userSoftDeleted, createdAt])
}

// Plaid cursor for incremental transaction sync. One per PlaidAccount, cascades on account removal.
model PlaidCursor {
  id             String       @id @default(uuid())
  plaidAccountId Int          @unique
  plaidAccount   PlaidAccount @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)
  cursor         String
  lastSyncAt     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Mutex for /transactions/sync. Row exists = sync in flight for that account.
// Stale rows (older than SYNC_LOCK_STALE_MS in syncTransactions.ts) are reclaimable.
model PlaidSyncLock {
  plaidAccountId Int          @id
  plaidAccount   PlaidAccount @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)
  acquiredAt     DateTime     @default(now())
}

enum ReportType {
  MONTHLY
  ANNUAL
}

enum ReportStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
}
